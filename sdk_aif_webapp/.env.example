# Signs the session cookie (which only holds a session id). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If blank, a random key is used and sessions end when the app restarts.
FLASK_SECRET_KEY=

# External IdP (public client, authorization code + PKCE)
EXTERNAL_DISCOVERY_URL=
EXTERNAL_CLIENT_ID=
# Must be registered with the IdP for this client.
EXTERNAL_REDIRECT_URI=http://localhost:5000/callback
# Add offline_access to get a refresh token (if the IdP allows it).
EXTERNAL_SCOPES=openid profile email
# Which IdP token to exchange with Databricks: access_token or id_token
EXTERNAL_SUBJECT_TOKEN=access_token
# Optional resource/audience for the external token
EXTERNAL_RESOURCE_ID=
EXTERNAL_RESOURCE_PARAM=resource

# Databricks workspace
DATABRICKS_HOST=
# Service principal application id that owns the federation policy (WIF).
# Leave blank for account-wide token federation.
DATABRICKS_CLIENT_ID=
# Scopes for the Databricks token (space or comma separated), e.g.
# "sql iam.current-user:read". Defaults to "all-apis" when blank.
DATABRICKS_SCOPES=
