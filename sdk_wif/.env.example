# External OAuth provider (client credentials grant)
EXTERNAL_TOKEN_ENDPOINT=
EXTERNAL_CLIENT_ID=
# Client authentication: set EXTERNAL_CLIENT_SECRET, OR a private key below
# (private_key_jwt). If a private key is set, the secret is not used.
EXTERNAL_CLIENT_SECRET=
EXTERNAL_RESOURCE_ID=
# Form field used to send EXTERNAL_RESOURCE_ID: "resource" (default, e.g. Entra
# v1 endpoint) or "scope" (e.g. Entra v2 with "<app-id-uri>/.default", Okta).
EXTERNAL_RESOURCE_PARAM=resource

# private_key_jwt (RFC 7523) client authentication
# PEM contents (use \n escapes on one line) or a file path - set only one.
EXTERNAL_PRIVATE_KEY=
EXTERNAL_PRIVATE_KEY_FILE=
EXTERNAL_PRIVATE_KEY_PASSWORD=
# RS256 (default), PS256 or ES256 (ES256 needs a P-256 EC key)
EXTERNAL_JWT_ALG=RS256
# Key identifier header(s) of the assertion. Entra ID uses x5t (base64url
# SHA-1 certificate thumbprint); Okta and others use kid.
EXTERNAL_JWT_KID=
EXTERNAL_JWT_X5T=
# Assertion audience; defaults to EXTERNAL_TOKEN_ENDPOINT.
EXTERNAL_JWT_AUDIENCE=

# Databricks workspace
DATABRICKS_HOST=
# Service principal application id that owns the federation policy (WIF).
# Leave blank for account-wide token federation.
DATABRICKS_CLIENT_ID=
# Scopes for the Databricks token (space or comma separated), e.g.
# "sql iam.current-user:read". Defaults to "all-apis" when blank.
DATABRICKS_SCOPES=
