# External OAuth provider (client credentials grant)
EXTERNAL_TOKEN_ENDPOINT=
EXTERNAL_CLIENT_ID=
EXTERNAL_CLIENT_SECRET=
EXTERNAL_RESOURCE_ID=
# Form field used to send EXTERNAL_RESOURCE_ID: "resource" (default, e.g. Entra
# v1 endpoint) or "scope" (e.g. Entra v2 with "<app-id-uri>/.default", Okta).
EXTERNAL_RESOURCE_PARAM=resource

# Databricks workspace
DATABRICKS_HOST=
# Service principal application id that owns the federation policy (WIF).
# Leave blank for account-wide token federation.
DATABRICKS_CLIENT_ID=
# Scopes for the Databricks token (space or comma separated), e.g.
# "sql iam.current-user:read". Defaults to "all-apis" when blank.
DATABRICKS_SCOPES=
